* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  user-select: none;
  -webkit-user-select: none;
  font-family: 'Press Start 2P', cursive;
}

html, body {
  width: 100vw;
  height: 100vh;
  background-color: #0b0c10;
  overflow: hidden;
}

.screen-wrapper {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  height: 100%;
}

/* മൊബൈലിലും പിസി ലാൻഡ്‌സ്‌കേപ്പിലും കൃത്യമായി സെന്ററിൽ ഒതുങ്ങുന്ന ബോക്സ് */
.game-container {
  position: relative;
  width: 100%;
  max-width: 360px;
  height: 100%;
  max-height: 600px;
  background-color: #4ec0ca;
  overflow: hidden;
  border: 4px solid #ffffff;
  border-radius: 8px;
  box-shadow: 0 15px 35px rgba(0, 0, 0, 0.85);
}

#flappyCanvas {
  display: block;
  width: 100%;
  height: 100%;
}

/* ഗെയിം കളിക്കുമ്പോഴുള്ള സ്കോർ ഡിസ്പ്ലേ */
#live-score {
  position: absolute;
  top: 30px;
  width: 100%;
  text-align: center;
  font-size: 34px;
  color: #fff;
  text-shadow: 3px 3px 0 #000, -3px -3px 0 #000, 3px -3px 0 #000, -3px 3px 0 #000;
  z-index: 5;
  pointer-events: none;
}

/* കാൻവാസിന് മുകളിലെ സ്ഥിരമായ ലെയറുകൾ (No Scrolling) */
.overlay-layer {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 10;
  display: flex;
  flex-direction: column;
}

/* ഹോം സ്ക്രീൻ */
#home-overlay {
  padding: 16px;
  justify-content: space-between;
}

.home-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.user-chip {
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 8px;
  padding: 8px 10px;
  border: 2px solid #fff;
  border-radius: 4px;
  cursor: pointer;
}

.top-high-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #fff;
  text-shadow: 2px 2px 0 #000;
}

.top-high-num {
  font-size: 16px;
}

.top-high-lbl {
  font-size: 6px;
  margin-top: 3px;
}

.home-body {
  text-align: center;
  margin-bottom: 90px;
}

.logo-title {
  font-size: 15px;
  color: #f7d51d;
  text-shadow: 2px 2px 0 #d9534f, -2px -2px 0 #000;
  margin-bottom: 25px;
}

.pixel-hand {
  font-size: 36px;
  animation: floatTap 1s infinite alternate ease-in-out;
}

@keyframes floatTap {
  0% { transform: translateY(0); }
  100% { transform: translateY(-10px); }
}

.tap-badge {
  display: inline-block;
  font-size: 9px;
  background: #f05323;
  color: #fff;
  border: 2px solid #000;
  padding: 6px 14px;
  margin-top: 8px;
}

/* ഗെയിം ഓവർ ബോർഡ് ലേഔട്ട് */
#gameover-overlay {
  background: rgba(0, 0, 0, 0.65);
  justify-content: center;
  align-items: center;
  padding: 15px;
}

.gameover-wrapper {
  width: 100%;
  max-width: 320px;
  text-align: center;
}

.gameover-title {
  color: #e84118;
  font-size: 22px;
  text-shadow: 3px 3px 0 #000;
  margin-bottom: 12px;
}

.tab-controls {
  display: flex;
  justify-content: center;
  gap: 4px;
}

.board-tab {
  background: #d4b574;
  border: 3px solid #543847;
  border-bottom: none;
  font-size: 7px;
  padding: 8px 12px;
  color: #543847;
  cursor: pointer;
}

.board-tab.active {
  background: #ecd497;
  color: #000;
}

.flappy-board {
  background: #ecd497;
  border: 4px solid #543847;
  border-radius: 6px;
  box-shadow: 0 6px 0 #543847;
  padding: 12px;
  margin-bottom: 14px;
}

.custom-card-text {
  font-size: 7px;
  line-height: 1.5;
  color: #333;
  padding-bottom: 10px;
  border-bottom: 2px solid #d4b574;
}

.sub-credit {
  font-size: 6px;
  color: #555;
  margin-top: 5px;
}

.sub-credit span {
  color: #e67e22;
}

.card-stats-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 10px;
}

.photo-slot img {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  border: 3px solid #e86100;
  object-fit: cover;
  background: #fff;
}

.stat-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
}

.stat-name {
  font-size: 7px;
  color: #b35900;
}

.stat-digit {
  font-size: 14px;
  color: #000;
}

/* ഡെയ്‌ലി ലീഡർബോർഡ് ലിസ്റ്റ് */
.daily-reset-tag {
  font-size: 6px;
  color: #777;
  margin-bottom: 8px;
}

.leaderboard-box {
  font-size: 7px;
  color: #000;
  line-height: 2.2;
  text-align: left;
  max-height: 110px;
  overflow-y: auto;
}

/* ബട്ടണുകൾ */
.pixel-btn {
  background: #4cd137;
  color: #fff;
  border: 3px solid #543847;
  box-shadow: 0 4px 0 #543847;
  font-size: 10px;
  padding: 12px;
  cursor: pointer;
  width: 100%;
}

.pixel-btn:active {
  transform: translateY(2px);
  box-shadow: 0 2px 0 #543847;
}

/* എഡിറ്റ് മോഡൽ */
.pixel-modal {
  margin: auto;
  background: #ecd497;
  border: 4px solid #543847;
  border-radius: 6px;
  padding: 16px;
  width: 80%;
  text-align: center;
}

.pixel-modal h3 {
  font-size: 9px;
  color: #543847;
  margin-bottom: 6px;
}

.pixel-modal p {
  font-size: 6px;
  color: #666;
  margin-bottom: 12px;
}

.pixel-modal input {
  width: 100%;
  font-size: 9px;
  padding: 8px;
  text-align: center;
  border: 2px solid #543847;
  margin-bottom: 12px;
}

.hidden {
  display: none !important;
}
