* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  user-select: none;
  -webkit-user-select: none;
  -webkit-touch-callout: none;
}

html, body {
  width: 100%;
  height: 100%;
  overflow: hidden;
  background-color: #0b0c10;
  font-family: 'Press Start 2P', cursive;
}

.screen-wrapper {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100vw;
  height: 100vh;
}

/* PC-യിൽ ഭംഗിയായി സെന്ററിൽ നിൽക്കാനും മൊബൈലിൽ മുഴുവനായി നിറയാനുമുള്ള ഡിസൈൻ */
.game-box {
  position: relative;
  width: 100%;
  max-width: 360px;
  height: 100%;
  max-height: 600px;
  background: #70c5ce;
  border: 4px solid #fff;
  border-radius: 10px;
  box-shadow: 0 15px 40px rgba(0, 0, 0, 0.9);
  overflow: hidden;
  touch-action: manipulation;
}

#flappyCanvas {
  display: block;
  width: 100%;
  height: 100%;
}

/* സ്കോർ ബോർഡ് ലുക്ക് */
#live-score {
  position: absolute;
  top: 30px;
  left: 0;
  width: 100%;
  text-align: center;
  font-size: 34px;
  color: #ffffff;
  text-shadow: 3px 3px 0 #000, -3px -3px 0 #000, 3px -3px 0 #000, -3px 3px 0 #000;
  z-index: 5;
  pointer-events: none;
}

/* ഓവർലേകൾ */
.panel-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.65);
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 15px;
  z-index: 10;
}

/* തുടക്ക മെനു കാർഡ് */
.retro-card {
  background: #ecd497;
  border: 4px solid #543847;
  border-radius: 8px;
  padding: 20px 14px;
  text-align: center;
  box-shadow: 0 6px 0 #543847;
  width: 100%;
}

.main-title {
  font-size: 15px;
  color: #e86100;
  margin-bottom: 12px;
  text-shadow: 2px 2px 0 #000;
}

.desc-text {
  font-size: 8px;
  line-height: 1.5;
  color: #333;
  margin-bottom: 12px;
}

.profile-preview img {
  width: 65px;
  height: 65px;
  border-radius: 50%;
  border: 3px solid #e86100;
  background: #fff;
  object-fit: cover;
  margin-bottom: 10px;
}

.credit-tag {
  font-size: 8px;
  color: #444;
  margin-bottom: 15px;
}

.credit-tag span {
  color: #0b7285;
}

/* ഒറിജിനൽ ഗെയിം ഓവർ ബോർഡ് */
.gameover-card {
  width: 100%;
  text-align: center;
}

.gameover-banner {
  color: #e84118;
  font-size: 24px;
  text-shadow: 3px 3px 0 #000;
  margin-bottom: 15px;
}

.score-board {
  background: #ecd497;
  border: 4px solid #543847;
  border-radius: 8px;
  padding: 15px;
  box-shadow: 0 6px 0 #543847;
  margin-bottom: 18px;
}

.board-top {
  display: flex;
  justify-content: space-around;
  border-bottom: 3px solid #d4b574;
  padding-bottom: 12px;
}

.score-col {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.label {
  font-size: 9px;
  color: #b35900;
}

.num {
  font-size: 18px;
  color: #000;
}

.board-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 12px;
}

.medal-circle img {
  width: 50px;
  height: 50px;
  border-radius: 50%;
  border: 3px solid #e86100;
  background: #fff;
  object-fit: cover;
}

/* പിക്സൽ ബട്ടൺ */
.pixel-btn {
  font-family: 'Press Start 2P', cursive;
  color: #fff;
  border: 3px solid #543847;
  padding: 14px;
  font-size: 10px;
  cursor: pointer;
  box-shadow: 0 5px 0 #543847;
  width: 100%;
  background: #4cd137;
}

.pixel-btn:active {
  transform: translateY(3px);
  box-shadow: 0 2px 0 #543847;
}

.hidden {
  display: none !important;
}
