* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  user-select: none;
}

body {
  background-color: #1a1a24;
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  font-family: 'Press Start 2P', cursive;
}

.game-container {
  position: relative;
  width: 360px;
  height: 580px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
  border: 4px solid #fff;
  border-radius: 12px;
  overflow: hidden;
  background-color: #70c5ce;
}

#gameCanvas {
  display: block;
}

#score-display {
  position: absolute;
  top: 30px;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 32px;
  color: #fff;
  text-shadow: 3px 3px 0 #000, -3px -3px 0 #000, 3px -3px 0 #000, -3px 3px 0 #000;
  z-index: 5;
}

/* Modal Popup Window */
.modal-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.75);
  backdrop-filter: blur(3px);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 10;
  padding: 15px;
}

.modal-box {
  background: #fbf6d9;
  border: 4px solid #543847;
  border-radius: 8px;
  padding: 20px 16px;
  width: 100%;
  box-shadow: 0 6px 0 #543847;
  text-align: center;
}

.modal-content {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 20px;
}

.text-content {
  text-align: left;
  flex: 1;
}

.game-title {
  font-size: 14px;
  color: #e86100;
  margin-bottom: 10px;
  text-shadow: 1px 1px 0 #000;
}

.description {
  font-size: 8px;
  color: #333;
  line-height: 1.4;
  margin-bottom: 8px;
}

.credits {
  font-size: 7px;
  color: #555;
}

.credits span {
  color: #0b7285;
  font-weight: bold;
}

/* Side Photo */
.image-box img {
  width: 65px;
  height: 65px;
  border-radius: 50%;
  border: 3px solid #e86100;
  background: #fff;
  object-fit: cover;
}

/* Retro Pixel Button */
.pixel-btn {
  font-family: 'Press Start 2P', cursive;
  background: #e86100;
  color: #fff;
  border: 3px solid #543847;
  padding: 12px 14px;
  font-size: 10px;
  cursor: pointer;
  box-shadow: 0 4px 0 #543847;
  transition: transform 0.1s;
  width: 100%;
}

.pixel-btn:hover {
  background: #f77f00;
}

.pixel-btn:active {
  transform: translateY(4px);
  box-shadow: 0 0 0 #543847;
}

.game-over-title {
  color: #d90429;
  font-size: 18px;
  margin-bottom: 15px;
  text-shadow: 2px 2px 0 #000;
}

.final-score {
  font-size: 12px;
  color: #333;
  margin-bottom: 20px;
}

.hidden {
  display: none !important;
}
