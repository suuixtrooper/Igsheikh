* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: 'Press Start 2P', cursive;
  user-select: none;
  -webkit-user-select: none;
}

html, body {
  width: 100vw;
  height: 100vh;
  background-color: #121212;
  overflow: hidden;
}

.screen-wrapper {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  height: 100%;
}

/* PC-യിൽ ലാൻഡ്‌സ്‌കേപ്പ് അനുയോജ്യമായ ഫ്രെയിം, ഫോണിൽ ഫുൾ വ്യൂ */
.game-box {
  position: relative;
  width: 100%;
  max-width: 400px;
  height: 100%;
  max-height: 640px;
  background-color: #4ec0ca;
  overflow: hidden;
  border: 4px solid #fff;
  border-radius: 8px;
  box-shadow: 0 10px 30px rgba(0,0,0,0.8);
}

#flappyCanvas {
  display: block;
  width: 100%;
  height: 100%;
}

#live-score {
  position: absolute;
  top: 40px;
  width: 100%;
  text-align: center;
  font-size: 32px;
  color: #fff;
  text-shadow: 3px 3px 0 #000, -3px -3px 0 #000, -3px 3px 0 #000, 3px -3px 0 #000;
  z-index: 5;
  pointer-events: none;
}

.panel-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 10;
  display: flex;
  flex-direction: column;
}

/* ഹോം സ്ക്രീൻ */
#home-overlay {
  background: transparent;
  justify-content: space-between;
  padding: 15px;
}

.home-top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.user-chip {
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 8px;
  padding: 8px 10px;
  border-radius: 4px;
  border: 2px solid #fff;
  cursor: pointer;
}

.top-high-score {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #fff;
  text-shadow: 2px 2px 0 #000;
}

.top-high-score .score-num {
  font-size: 16px;
}

.top-high-score .score-lbl {
  font-size: 6px;
  margin-top: 3px;
}

.home-center {
  margin-bottom: 90px;
  text-align: center;
}

.brand-title h2 {
  font-size: 14px;
  color: #f7d51d;
  text-shadow: 2px 2px 0 #d9534f, -2px -2px 0 #000;
  margin-bottom: 30px;
}

.tap-instruction {
  display: flex;
  flex-direction: column;
  align-items: center;
  cursor: pointer;
}

.finger-anim {
  font-size: 36px;
  animation: bounce 1s infinite alternate;
}

@keyframes bounce {
  from { transform: translateY(0); }
  to { transform: translateY(-10px); }
}

.pixel-tag {
  font-size: 9px;
  color: #fff;
  background: #f05323;
  padding: 6px 12px;
  border: 2px solid #000;
  margin-top: 8px;
}

/* ഗെയിം ഓവർ */
#gameover-overlay {
  background: rgba(0, 0, 0, 0.6);
  justify-content: center;
  align-items: center;
  padding: 15px;
}

.gameover-container {
  width: 100%;
  max-width: 320px;
  text-align: center;
}

.gameover-banner {
  font-size: 20px;
  color: #e84118;
  text-shadow: 3px 3px 0 #000;
  margin-bottom: 12px;
}

.tab-header {
  display: flex;
  justify-content: center;
  gap: 4px;
  margin-bottom: -4px;
}

.tab-btn {
  background: #c7a760;
  border: 2px solid #543847;
  border-bottom: none;
  font-size: 7px;
  padding: 8px 10px;
  cursor: pointer;
  color: #fff;
}

.tab-btn.active {
  background: #ecd497;
  color: #543847;
}

.retro-board {
  background: #ecd497;
  border: 4px solid #543847;
  border-radius: 6px;
  padding: 12px;
  box-shadow: 0 6px 0 #543847;
  margin-bottom: 15px;
}

.board-top-section {
  display: flex;
  justify-content: space-around;
  border-bottom: 2px solid #d4b574;
  padding-bottom: 8px;
}

.board-label {
  font-size: 8px;
  color: #c0392b;
  display: block;
  margin-bottom: 4px;
}

.board-num {
  font-size: 14px;
  color: #000;
}

.board-desc-box {
  padding: 8px 0;
  border-bottom: 2px solid #d4b574;
}

.board-desc-box p {
  font-size: 7px;
  line-height: 1.4;
  color: #2c3e50;
  margin-bottom: 4px;
}

.board-desc-box small {
  font-size: 6px;
  color: #555;
}

.board-desc-box small span {
  color: #e67e22;
}

.board-bottom-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 8px;
}

.medal-avatar img {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  border: 3px solid #d35400;
  object-fit: cover;
  background: #fff;
}

.rank-list {
  font-size: 8px;
  text-align: left;
  line-height: 2;
  color: #000;
  max-height: 120px;
  overflow-y: auto;
}

.pixel-btn {
  background: #2ecc71;
  color: #fff;
  border: 3px solid #543847;
  padding: 12px;
  font-size: 9px;
  box-shadow: 0 4px 0 #543847;
  cursor: pointer;
  width: 100%;
}

.pixel-btn:active {
  transform: translateY(2px);
  box-shadow: 0 2px 0 #543847;
}

/* മോഡൽ */
.modal-box {
  margin: auto;
  padding: 15px;
  width: 80%;
}

.modal-title {
  font-size: 9px;
  color: #543847;
  margin-bottom: 6px;
}

.modal-sub {
  font-size: 6px;
  color: #666;
  margin-bottom: 10px;
}

.modal-box input {
  width: 100%;
  padding: 8px;
  font-size: 8px;
  margin-bottom: 10px;
  text-align: center;
  border: 2px solid #543847;
}

.hidden {
  display: none !important;
}
