* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  user-select: none;
  -webkit-user-select: none;
  -webkit-touch-callout: none;
}

html, body {
  width: 100%;
  height: 100%;
  overflow: hidden;
  background-color: #121218;
  font-family: 'Press Start 2P', cursive;
}

.main-wrapper {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  height: 100%;
  padding: 10px;
}

/* ഫോണിലും കമ്പ്യൂട്ടറിലും ഒരുപോലെ ഒതുങ്ങിയിരിക്കുന്ന ഫ്രെയിം */
.game-container {
  position: relative;
  width: 100%;
  max-width: 360px;
  height: 100%;
  max-height: 580px;
  aspect-ratio: 360 / 580;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.7);
  border: 4px solid #fff;
  border-radius: 12px;
  overflow: hidden;
  background-color: #70c5ce;
  touch-action: manipulation;
}

#gameCanvas {
  width: 100%;
  height: 100%;
  display: block;
}

#score-display {
  position: absolute;
  top: 25px;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 30px;
  color: #fff;
  text-shadow: 3px 3px 0 #000, -3px -3px 0 #000, 3px -3px 0 #000, -3px 3px 0 #000;
  z-index: 5;
  pointer-events: none;
}

/* പോപ്പ്-അപ്പ് മെനു */
.modal-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.78);
  backdrop-filter: blur(4px);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 10;
  padding: 16px;
}

.modal-box {
  background: #fbf6d9;
  border: 4px solid #543847;
  border-radius: 10px;
  padding: 18px 14px;
  width: 100%;
  max-width: 320px;
  box-shadow: 0 6px 0 #543847;
  text-align: center;
}

.modal-content {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-bottom: 18px;
}

.text-content {
  text-align: left;
  flex: 1;
}

.game-title {
  font-size: 13px;
  color: #e86100;
  margin-bottom: 8px;
  text-shadow: 1px 1px 0 #000;
}

.description {
  font-size: 8px;
  color: #333;
  line-height: 1.4;
  margin-bottom: 8px;
}

.credits {
  font-size: 7px;
  color: #555;
  line-height: 1.3;
}

.credits span {
  color: #0b7285;
  font-weight: bold;
}

/* മെനുവിലെ ചിത്രം */
.image-box img {
  width: 62px;
  height: 62px;
  border-radius: 50%;
  border: 3px solid #e86100;
  background: #fff;
  object-fit: cover;
  flex-shrink: 0;
}

/* പിക്സൽ ബട്ടൺ */
.pixel-btn {
  font-family: 'Press Start 2P', cursive;
  background: #e86100;
  color: #fff;
  border: 3px solid #543847;
  padding: 14px 10px;
  font-size: 10px;
  cursor: pointer;
  box-shadow: 0 4px 0 #543847;
  transition: transform 0.08s;
  width: 100%;
  display: block;
}

.pixel-btn:hover {
  background: #f77f00;
}

.pixel-btn:active {
  transform: translateY(3px);
  box-shadow: 0 1px 0 #543847;
}

.game-over-title {
  color: #d90429;
  font-size: 18px;
  margin-bottom: 14px;
  text-shadow: 2px 2px 0 #000;
}

.final-score {
  font-size: 12px;
  color: #333;
  margin-bottom: 18px;
}

.hidden {
  display: none !important;
}
